# Get these at https://my.telegram.org -> API development tools
API_ID=12345678
API_HASH=your_api_hash_here

# Account phone number (with country code)
PHONE=+79001234567

# Target chat ID (supergroup). Run get_topic_id.py to find it
CHAT_ID=-1001234567890

# Forum topic ID (message_thread_id). Run get_topic_id.py to find it
TOPIC_ID=123

# Delay between sends in HOURS (fractional allowed: 1.5 = 1h 30m)
DELAY_HOURS=3
